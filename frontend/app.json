{
  "expo": {
    "name": "Digital Book Reader",
    "slug": "digital-book-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitalbook.reader"
    },
    "android": {
      "package": "com.digitalbook.reader",
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
