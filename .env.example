# Required for the local AI Studio app behavior.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: deployed frontend base URL used by this app when hosted separately.
APP_URL="MY_APP_URL"

# Frontend API endpoint for production deployments.
# Example: https://digital-book-backend.onrender.com
VITE_API_URL="https://your-render-backend.onrender.com"

# Optional alternate variable naming.
VITE_BACKEND_URL="https://your-render-backend.onrender.com"
